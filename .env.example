# Copy to .env and fill in your own local values.

# Long random string. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Your OWN local PostgreSQL database for the FastAPI rewrite (fresh/empty).
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/voiceportal

# CarrierX. Placeholders are fine for local UI work.
CARRIERX_ACCESS_TOKEN=dummy
CARRIERX_CONTAINER_SID=dummy

# Shared secret telephony providers must send as X-Webhook-Key.
CALL_WEBHOOK_API_KEY=
